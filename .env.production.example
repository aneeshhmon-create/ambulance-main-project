# Copy to .env.production on the server and fill in. Never commit the real file.
APP_ENV=production

# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET=
ALLOW_DEV_LOGIN=false

POSTGRES_USER=ambulance
POSTGRES_PASSWORD=
POSTGRES_DB=ambulance_db
# Host is the compose service name "db".
DATABASE_URL=postgresql+psycopg2://ambulance:<POSTGRES_PASSWORD>@db:5432/ambulance_db

GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Hostnames Caddy serves. With no domain, use sslip.io with the server's Elastic IP,
# e.g. IP 3.110.1.2 ->  api.3-110-1-2.sslip.io  and  dash.3-110-1-2.sslip.io
API_HOST=
DASH_HOST=
# Browser origin of the dashboard (https://<DASH_HOST>)
CORS_ORIGINS=
