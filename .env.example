# Application
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL / PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ambulance_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Constructed from the above — used by SQLAlchemy
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ambulance_db

# ── Driver Authentication ─────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → Web client
# (same ID used in the Flutter app as GOOGLE_SERVER_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Secret used to sign and verify our own JWT access tokens.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-jwt-secret

# How long (minutes) our JWT tokens are valid. Default: 10080 = 7 days.
JWT_EXPIRE_MINUTES=10080

# ── Development / Testing override ───────────────────────────────────────────
# WARNING: Set ALLOW_DEV_LOGIN=true ONLY for local development when Google OAuth
# is not yet configured. This enables POST /auth/dev-login which skips Google
# verification entirely. NEVER enable this in production.
ALLOW_DEV_LOGIN=True
