# Application
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL / PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ambulance_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Constructed from the above — used by SQLAlchemy
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ambulance_db
