# Base URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000
# Polling interval in milliseconds (3000-5000 recommended)
VITE_POLL_INTERVAL_MS=4000

# Google OAuth 2.0 *Web* client ID — must be the same value as GOOGLE_CLIENT_ID
# on the backend. Add http://localhost:5173 under "Authorized JavaScript origins"
# for this client in Google Cloud Console (see ../docs/google_signin_setup.md).
VITE_GOOGLE_CLIENT_ID=
# Shows a "Dev login" form that skips Google. Needs ALLOW_DEV_LOGIN=true on the
# backend. Never enable in production.
VITE_ALLOW_DEV_LOGIN=false
